{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "paths": {
      "three": ["./node_modules/@types/three"],
      "three/addons/*": ["./node_modules/@types/three/examples/jsm/*"]
    }
  },
  "include": [
    "src/core/events.js",
    "src/core/spring.js",
    "src/core/quality.js",
    "src/config/session.js",
    "src/config/player.js",
    "src/config/weapons.js",
    "src/config/waves.js",
    "src/config/powerups.js",
    "src/config/monsters.js",
    "src/enemies/waveComposition.js",
    "src/core/utils.js",
    "src/core/collision.js",
    "src/world/staticBatch.js",
    "src/world/pier.js",
    "src/vfx/labels.js",
    "src/vfx/particles.js",
    "src/vfx/hitmarker.js",
    "src/vfx/impacts.js",
    "src/vfx/beam.js",
    "src/enemies/monsterLights.js",
    "src/player/fpcamera.js"
  ]
}
