{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true
  },
  "include": [
    "src/core/events.js",
    "src/core/spring.js",
    "src/core/quality.js",
    "src/config/session.js",
    "src/config/player.js",
    "src/config/weapons.js",
    "src/config/waves.js",
    "src/config/powerups.js",
    "src/config/monsters.js",
    "src/enemies/waveComposition.js"
  ]
}
